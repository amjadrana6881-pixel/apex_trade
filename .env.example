# =================================================================
# 🚀 ApexTrade PRO Full-Stack Environment Configuration
# =================================================================

# Server Port & Core Security
PORT=5001
JWT_SECRET=apextrade_super_secure_jwt_secret_key_2026_x991

# =================================================================
# 🛡️ MASTER ADMIN CREDENTIALS (Super Admin Portal)
# Admin Login Page URL: /admin-secure-auth (or /admin-login)
# Admin Dashboard URL: /admin
# =================================================================
ADMIN_EMAIL=admin@apextrade.net
ADMIN_PASSWORD=admin123

# =================================================================
# 📧 REAL-TIME EMAIL & OTP DISPATCH CONFIGURATION (Nodemailer)
# =================================================================
# OPTION 1: Using Gmail (Recommended & Easiest)
# 1. Enable 2-Step Verification on your Gmail account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create a 16-character App Password (e.g. 'abcd efgh ijkl mnop').
# 4. Fill in EMAIL_USER and EMAIL_PASS below:
EMAIL_USER=
EMAIL_PASS=

# OPTION 2: Using Custom SMTP Server (Hostinger, cPanel, SendGrid, Amazon SES, etc.)
# Leave empty if using Gmail above.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ApexTrade Security" <noreply@apextrade.net>

# =================================================================
# 🌐 NETLIFY DEPLOYMENT NOTE:
# When deploying to Netlify, add these same variables in:
# Netlify Dashboard -> Site Configuration -> Environment Variables
# =================================================================
