# =================================================================
# 🚀 ApexTrade PRO Next.js Full-Stack Environment Configuration
# =================================================================

# Server Port & Core Security
PORT=3000
JWT_SECRET=your_super_secure_jwt_secret_key_here

# =================================================================
# 🍃 MONGODB DATABASE CONNECTION
# =================================================================
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/apextrade?retryWrites=true&w=majority

# =================================================================
# 🛡️ MASTER ADMIN CREDENTIALS (Super Admin Portal)
# Admin Login Page URL: /admin-secure-auth (or /admin-login)
# Admin Dashboard URL: /admin
# =================================================================
ADMIN_EMAIL=roman@nabil.com
ADMIN_PASSWORD=your_admin_password_here

# =================================================================
# 📧 REAL-TIME EMAIL & OTP DISPATCH CONFIGURATION (Nodemailer)
# =================================================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="ApexTrade Security" <your_email@gmail.com>
